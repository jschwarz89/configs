// -*- mode: jsonc -*-
[{
  "output": "DP-3",
  "modules-left": ["hyprland/workspaces"],
  "modules-right": ["custom/clock"],

  // Modules configuration
  "hyprland/workspaces": {
    "active-only": false,
    "sort-by-number": true,
    "on-click": "activate",
    "all-outputs": true,
    "format": "{id} {windows}",
    //"format-icons": {
      //"active": "󰮯",
      //"default": "•",
    //},
    "window-rewrite": {
        "title<.*youtube.*>": "",
        "class<google-chrome>": "",
        "class<kitty>": "",
        "class<slack>": "",
        "class<vlc>": "󰕼"
    },
    "move-to-monitor": true,
  },
  "hyprland/window": {
    "icon": true,
    "rewrite": {
        "nvim ([^ ]+).*": "nvim [$1]",
        "narf": "kitty",
        "john@narf.*": "kitty",
        "(.*) - Google Chrome": "Google Chrome [$1]",
    }
  },
  "custom/clock": {
    "exec": "date +'%d/%m/%y %H:%M:%S'",
    "interval": 1
  },
},
{
  //"layer": "top", // Waybar at top layer
  "height": 40,
  "output": ["eDP-1", "DP-1", "HDMI-A-1"],
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-right": ["tray", "hyprland/language", "group/hw", "group/control", "custom/clock"],

  // Modules configuration
  "hyprland/workspaces": {
    "active-only": false,
    "sort-by-number": true,
    "on-click": "activate",
    "all-outputs": true,
    "format": "{id} {windows}",
    //"format-icons": {
      //"active": "󰮯",
      //"default": "•",
    //},
    "window-rewrite": {
        "title<.*youtube.*>": "",
        "class<google-chrome>": "",
        "class<kitty>": "",
        "class<slack>": "",
        "class<vlc>": "󰕼"
    },
    "move-to-monitor": true,
  },
  "hyprland/window": {
    "icon": true,
    "rewrite": {
        "nvim ([^ ]+).*": "nvim",
        "narf": "kitty",
        "john@narf.*": "kitty",
        "(.*) - Google Chrome": "Google Chrome",
        "(.*) - Slack": "Slack",
    }
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8,
  },
  "hyprland/language": {
	"format-en": "<span color='#b2ccd6'></span>  en",
	"format-he": "<span color='#b2ccd6'></span>  he",
  },
  "group/hw": {
    "orientation": "horizontal",
    "modules": ["cpu", "temperature", "disk", "memory"],
  },
  "cpu": {
    "format": "<span color='#b2ccd6'>󰍛</span> {usage}%",
    "interval": 2,
    "on-click": "kitty btop",
  },
  "temperature": {
    "format": "<span color='#f07178'></span> {temperatureC}󰔄",
    "interval": 2,
    "on-click": "kitty btop",
  },
  "disk": {
    "format": " <span color='#a0eb93'></span> {percentage_used}%",
    "interval": 2,
    "on-click": "kitty btop",
  },
  "memory": {
    "format": "<span color='#c792ea'>󰘚</span> {used:.2g}GB",
    "interval": 2,
    "on-click": "kitty btop",
  },
  "group/control": {
    "orientation": "horizontal",
    "modules": ["battery", "network", "bluetooth", "pulseaudio"],
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "<span color='#c3e88d'>{icon}</span> {capacity}%",
    "format-charging": "<span color='#c3e88d'>󱐋</span> {capacity}%",
    "format-plugged": "<span color='#c3e88d'></span> {capacity}%",
    "tooltip-format": "{time} left",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂁", "󰁹"],
  },
  "network": {
    "format-ethernet": "<span color='#89ddff'>󰈀</span> {bandwidthDownBytes:=}",
    "format-wifi": " <b>{essid}</b> <span color='#89ddff'>{icon}</span> {bandwidthDownBytes:=}",
    "format-disconnected": "<span color='#89ddff'>󰤭</span> {bandwidthDownBytes:=}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "interval": 2,
    "tooltip-format": "{essid}",
    "on-click": "nm-applet",
    "on-click-right": "killall nm-applet",
  },
  "bluetooth": {
    "format": "<span color='#82aaff'></span> {status}",
    "format-connected-battery": "<span color='#82aaff'></span> {device_battery_percentage}%",
    "tooltip-format": "{device_alias} {status}",
    "on-click": "blueman-applet",
    "on-click-right": "killall blueman-applet",
  },
  "pulseaudio": {
    "format": "<span color='#f78c6c'>{icon}</span> {volume}%",
    "format-muted": "<span color='#f78c6c'>󰖁</span> {volume}%",
    "format-bluetooth": "<span color='#f78c6c'>{icon}</span> {volume}%",
    "format-bluetooth-muted": "<span color='#f78c6c'>󰖁</span> {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "phone": "󰏲",
      "portable": "󰏲",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "pavucontrol",
  },
    "custom/clock": {
        "exec": "date +'%d/%m/%y %H:%M:%S'",
        "interval": 1
    },
}]
